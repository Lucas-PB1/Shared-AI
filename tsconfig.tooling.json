{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "packages/code-review/src/**/*.ts",
    "packages/code-review/bin/**/*.ts",
    "packages/code-review/tests/**/*.ts",
    "packages/cursor/scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "vendor", "app", "src"]
}
