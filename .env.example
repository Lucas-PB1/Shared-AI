# Copie para .env (gitignored). Nunca commitar secrets reais.
# Preencha com `npm run env:switch -- local|cloud [--refresh-keys]`
# ou cole URL/keys do Dashboard → Settings → API Keys.

# ---------------------------------------------------------------------------
# Target ativo: local | cloud
# ---------------------------------------------------------------------------
SUPABASE_TARGET=local

# --- Local Docker (exemplo) ---
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_PUBLISHABLE_KEY=sb_publishable_example_local
SUPABASE_LOCAL_SECRET_KEY=sb_secret_example_local

# --- Cloud (exemplo — troque pelo seu projeto) ---
SUPABASE_CLOUD_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_CLOUD_PUBLISHABLE_KEY=sb_publishable_example_cloud
SUPABASE_CLOUD_SECRET_KEY=sb_secret_example_cloud

# --- Resolvidos pelo env:switch (app + tooling) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_example_local
# Alias para CLIs/CI antigos (= SECRET)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_example_local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_local
NEXT_PUBLIC_SUPABASE_TARGET=local

# Permite /settings gravar .env (só server, só is_admin)
ALLOW_ENV_WRITE=1

# Slug do projeto no review store
REVIEW_PROJECT_SLUG=example-project
