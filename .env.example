# Copie para .env (gitignored). Nunca commitar secrets de produção.
# Review store é sempre obrigatório (sem modo offline).

# --- Cloud HostDime (default de ops) ---
# Dashboard: https://supabase.com/dashboard/project/toekmpljxeulcquqhkxt
SUPABASE_URL=https://toekmpljxeulcquqhkxt.supabase.co
# Project Settings → API → service_role (secret) — só tooling/CI, nunca no browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard Next.js (apps/web) — anon key pública ---
# Mesma URL; chave anon em Project Settings → API → anon / public
NEXT_PUBLIC_SUPABASE_URL=https://toekmpljxeulcquqhkxt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth cloud: Authentication → Providers → Email → Confirm email = OFF
# Local: supabase/config.toml já tem enable_confirmations = false

# --- Local Docker (opcional) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=  # npm run supabase:status
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # npm run supabase:status → anon key

# Default monorepo. Repos ligados: dual-write usa git remote / --slug
# (seed: dna, core, hdbr-*, hostdime-hub, hostdime-backend, hostdime-organograma…).
REVIEW_PROJECT_SLUG=hostdime-ia
