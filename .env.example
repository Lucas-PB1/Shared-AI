# Bootstrap do monorepo (gitignored em .env).
# Pares local/cloud: tabela app_connections em /settings.
# Nunca commitar secrets reais.
#
# Preencha após `npm run setup`, ou use:
#   npm run env:switch -- local --refresh-keys
#   npm run connections:seed

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alias para CLIs/CI (= SECRET)
SUPABASE_SERVICE_ROLE_KEY=

REVIEW_PROJECT_SLUG=
