{
  "name": "hostdime-ia",
  "version": "0.3.0",
  "private": true,
  "description": "Pacotes públicos de configuração de IA da HostDime",
  "type": "module",
  "scripts": {
    "setup:skills": "node packages/cursor/scripts/run.mjs install",
    "setup:code-review": "npm install && composer install && node packages/cursor/scripts/run.mjs setup-code-review",
    "bootstrap": "node packages/cursor/scripts/run.mjs bootstrap",
    "detach": "node packages/cursor/scripts/run.mjs detach",
    "sync": "node packages/cursor/scripts/run.mjs sync",
    "status": "node packages/cursor/scripts/run.mjs status",
    "doctor": "node packages/cursor/scripts/run.mjs doctor",
    "boot-sync": "node packages/cursor/scripts/run.mjs boot-sync",
    "historico": "node packages/cursor/scripts/run.mjs historico",
    "memoria": "node packages/cursor/scripts/run.mjs memoria",
    "cursor-cli": "node packages/cursor/scripts/run.mjs cursor-cli",
    "agent": "node packages/cursor/scripts/run.mjs agent",
    "sync-inbox": "node packages/cursor/scripts/run.mjs sync-inbox",
    "onboard": "node packages/cursor/scripts/run.mjs onboard",
    "health": "node packages/cursor/scripts/run.mjs health",
    "review:ci": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/review-ci.sh",
    "review:github-pr": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/review-github-pr.sh",
    "review:export-exclusions": "bash packages/code-review/tools/review-export-exclusions.sh",
    "test": "bash tests/run-all.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
