{
  "name": "hostdime-ia",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Pacotes públicos de configuração de IA da HostDime + dashboard Next.js",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup:skills": "node packages/cursor/scripts/mjs/run.mjs install",
    "setup:code-review": "npm install && composer install && node packages/cursor/scripts/mjs/run.mjs setup-code-review",
    "bootstrap": "node packages/cursor/scripts/mjs/run.mjs bootstrap",
    "detach": "node packages/cursor/scripts/mjs/run.mjs detach",
    "sync": "node packages/cursor/scripts/mjs/run.mjs sync",
    "status": "node packages/cursor/scripts/mjs/run.mjs status",
    "doctor": "node packages/cursor/scripts/mjs/run.mjs doctor",
    "boot-sync": "node packages/cursor/scripts/mjs/run.mjs boot-sync",
    "historico": "node packages/cursor/scripts/mjs/run.mjs historico",
    "memoria": "node packages/cursor/scripts/mjs/run.mjs memoria",
    "cursor-cli": "node packages/cursor/scripts/mjs/run.mjs cursor-cli",
    "agent": "node packages/cursor/scripts/mjs/run.mjs agent",
    "sync-inbox": "node packages/cursor/scripts/mjs/run.mjs sync-inbox",
    "onboard": "node packages/cursor/scripts/mjs/run.mjs onboard",
    "health": "node packages/cursor/scripts/mjs/run.mjs health",
    "review:ci": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/sh/review-ci.sh",
    "review:github-pr": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/sh/review-github-pr.sh",
    "review:ingest-pr": "bash packages/code-review/tools/sh/review-ingest-pr-decisions.sh",
    "review:validate-ingest": "tsx packages/code-review/bin/review-validate-ingest.ts",
    "review:export-exclusions": "bash packages/code-review/tools/sh/review-export-exclusions.sh",
    "pre-commit": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/sh/review-pre-commit.sh",
    "hooks:pre-commit": "HOSTDIME_IA_ROOT=\"$(pwd)\" bash packages/code-review/tools/sh/install-pre-commit.sh",
    "lint:shell": "bash tests/lint-shell.sh",
    "lint:ts": "bash tests/lint-ts.sh",
    "test:review-unit": "bash tests/run-review-unit.sh",
    "test": "bash tests/run-all.sh",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:reset": "npx supabase db reset",
    "supabase:link": "npx supabase link --project-ref toekmpljxeulcquqhkxt",
    "supabase:db-push": "npx supabase db push",
    "env:switch": "node scripts/env-switch.mjs",
    "setup": "node scripts/setup-project.mjs",
    "connections:seed": "node scripts/seed-connections.mjs",
    "review:store-smoke": "tsx packages/code-review/bin/review-store-smoke.ts",
    "review:dual-write": "tsx packages/code-review/bin/review-dual-write.ts",
    "review:store-publish": "tsx packages/code-review/bin/review-store-publish.ts",
    "review:memory-pull": "tsx packages/code-review/bin/review-memory-pull.ts",
    "review:memory-push": "tsx packages/code-review/bin/review-memory-push.ts",
    "review:backfill-pr-people": "tsx packages/code-review/bin/review-backfill-pr-people.ts",
    "review:backfill-finding-keys": "tsx packages/code-review/bin/review-backfill-finding-keys.ts",
    "review:backfill-convention-prs": "tsx packages/code-review/bin/review-backfill-convention-prs.ts",
    "review:purge-non-ci": "tsx packages/code-review/bin/review-purge-non-ci-runs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.4.0",
    "nuqs": "^2.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.4.0",
    "globals": "^16.2.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
