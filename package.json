{
  "name": "hostdime-ia",
  "version": "0.2.0",
  "private": true,
  "description": "Pacotes públicos de configuração de IA da HostDime",
  "type": "module",
  "scripts": {
    "setup:skills": "bash packages/cursor/scripts/install.sh --hooks",
    "setup:code-review": "npm install && composer install && bash packages/code-review/scripts/install.sh",
    "bootstrap": "bash packages/cursor/scripts/bootstrap-project.sh",
    "sync": "bash packages/cursor/scripts/sync-all.sh",
    "status": "bash packages/cursor/scripts/status.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
